# Локальные демонстрационные настройки PostgreSQL. Не используйте реальные банковские данные.
POSTGRES_DB=credit_cabinet
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# Cookie остаётся доступной только по HTTP в локальной разработке.
SESSION_COOKIE_NAME=credit_cabinet_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Необязательный локальный помощник. Обычный кабинет работает без модели.
ASSISTANT_ENABLED=false
# Основной вариант: Ollama на этом же ПК, приложение в Docker Desktop.
# Дополнительный Docker-профиль: http://ollama:11434/v1; другой ПК: http://IP_ПК:11434/v1.
LLM_BASE_URL=http://host.docker.internal:11434/v1
# У локальной Ollama может быть пустым; ключ провайдера хранить только в .env.
LLM_API_KEY=
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Ожидание ответа 1–300 секунд; первый запрос на CPU может быть долгим.
LLM_TIMEOUT_SECONDS=180
# json_schema / json_object / none — по возможностям провайдера.
LLM_RESPONSE_FORMAT=json_schema
FRONTEND_PORT=8080

# Лимит CPU необязательного контейнера Ollama.
OLLAMA_CPU_LIMIT=4
