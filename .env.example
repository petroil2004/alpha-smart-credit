# Локальные демонстрационные настройки PostgreSQL. Не используйте реальные банковские данные.
POSTGRES_DB=credit_cabinet
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# Cookie остаётся доступной только по HTTP в локальной разработке.
SESSION_COOKIE_NAME=credit_cabinet_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Необязательный локальный помощник. Обычный кабинет работает без модели.
ASSISTANT_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=90
